{
  "expo": {
    "name": "Collectibles",
    "slug": "collectibles",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "collectibles",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#F7F4EE"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "Collectibles",
      "description": "A private home for your collections."
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EE"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for an item in your private collection.",
          "cameraPermission": "Take a photo of an item for your private collection.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-system-ui"
    ]
  }
}
