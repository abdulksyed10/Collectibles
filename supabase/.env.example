# Server-only configuration. Copy to supabase/.env.local (ignored by Git).
# Store these values as Supabase Edge Function secrets for deployment.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are supplied
# automatically to hosted Edge Functions; do not add them to the mobile app.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Required by the public-safety function only when anonymous reporting is
# enabled. This is the private Turnstile secret, never the public site key.
TURNSTILE_SECRET_KEY=

# Exact browser origins, comma-separated. Native requests omit Origin.
MEDIA_ALLOWED_ORIGINS=http://localhost:8081
# Optional override: server-only Supabase transaction pooler connection string.
# Hosted functions otherwise use their automatically supplied SUPABASE_DB_URL.
MEDIA_DATABASE_URL=
# Only for local Supabase: opt in to a non-TLS loopback/local database connection.
MEDIA_ALLOW_LOCAL_DATABASE=false
# Used only by the maintenance runner and provider-grants function. Generate
# PROVIDER_TOKEN_ENCRYPTION_KEY as 32 random bytes encoded with standard base64.
# Apple values stay empty until Apple sign-in is configured and tested.
PROVIDER_TOKEN_ENCRYPTION_KEY=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CLIENT_IDS=
# For maintenance outside hosted Supabase, also set SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY here or in that runner's secret store. Never put
# either value in the mobile app, Vercel client configuration, or Git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
