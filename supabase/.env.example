# Server-only configuration. Copy to supabase/.env.local (ignored by Git).
# Store these values as Supabase Edge Function secrets for deployment.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are supplied
# automatically to hosted Edge Functions; do not add them to the mobile app.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
