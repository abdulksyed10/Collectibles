{
  "name": "collectibles",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts tests/backend/*.test.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:backend-config": "tsx scripts/check-backend-config.ts",
    "check:release-config": "tsx scripts/check-release-config.ts",
    "build:web": "node scripts/build-web.mjs",
    "test:e2e": "playwright test",
    "preview": "node scripts/serve-preview.mjs",
    "setup:hooks": "git config core.hooksPath .githooks",
    "eas-build-post-install": "tsx scripts/check-release-config.ts native"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
