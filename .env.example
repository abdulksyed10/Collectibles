# Client configuration only. Copy to .env.local (ignored by Git).
# Supabase publishable keys are designed to be included in the app bundle.
# Never put service-role, database, R2, or deployment secrets in EXPO_PUBLIC_*.
# Leave disabled during frontend development. Demo works with no keys.
EXPO_PUBLIC_ENABLE_BACKEND=false
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Deployed HTTPS web app URL for sharing links from Android/iOS.
# Web uses its current origin; never use the Supabase project URL here.
EXPO_PUBLIC_WEB_URL=
# Set true only after Google and Apple are configured in Supabase and their
# provider dashboards. This is a public feature flag, not a credential.
EXPO_PUBLIC_ENABLE_SOCIAL_LOGIN=false
# Optional public Cloudflare Turnstile site key. Its secret belongs only in
# Supabase Auth settings, never here or in a native build.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
